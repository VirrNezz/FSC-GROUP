# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# PUBLIC — safe to ship in the browser bundle (anything prefixed VITE_ is
# inlined into client JS by Vite at build time). Set these in Vercel under
# both "Production" and "Preview/Development" as needed.
# =========================================================================

# Firebase Web config. Not secret by Firebase's own design — access control
# lives in firestore.rules, not in hiding this value. Required for custom
# deployments like Vercel; optional for local AI Studio preview.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# OneSignal App ID. Also not secret — OneSignal's docs treat this as a
# public identifier, same as a Firebase App ID.
VITE_ONESIGNAL_APP_ID=""

# =========================================================================
# SECRET — server-only. NEVER prefix these with VITE_, or Vite will bundle
# them straight into the public JS and anyone can read them in DevTools.
# Set these in Vercel under "Environment Variables" WITHOUT exposing them
# to a specific framework preset that auto-prefixes — plain names below.
# =========================================================================

# OneSignal REST API key — grants the ability to broadcast push
# notifications to every subscriber. Only used inside
# api/broadcast-notification.js. Rotate this in the OneSignal dashboard if
# it was ever exposed to the client (see the security notes for how to check).
ONESIGNAL_REST_API_KEY=""

# Optional: server-side copy of the OneSignal App ID. Falls back to
# VITE_ONESIGNAL_APP_ID above if unset, so you usually don't need this.
ONESIGNAL_APP_ID=""

# Optional: comma-separated allowlist of admin emails permitted to send
# broadcasts. Defaults to the same two emails already in firestore.rules
# if left unset.
ADMIN_EMAILS="ochalopha@gmail.com,furrsocietyclan@gmail.com"

