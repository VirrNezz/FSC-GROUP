rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Aturan untuk koleksi groups
    match /groups/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.email == 'ochalopha@gmail.com' || request.auth.token.email == 'furrsocietyclan@gmail.com');
    }
    
    // 2. Aturan untuk koleksi admins
    match /admins/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        (request.auth.token.email == 'ochalopha@gmail.com' || request.auth.token.email == 'furrsocietyclan@gmail.com');
    }

    // 3. Aturan khusus koleksi playlists (Mencegah user biasa menghapus playlist)
    match /playlists/{playlistId} {
      // Semua orang bisa melihat dan membuat playlist
      allow read, create: if true;
      
      // HANYA email admin terdaftar yang boleh menghapus atau mengubah playlist
      allow update, delete: if request.auth != null && 
        (request.auth.token.email == 'ochalopha@gmail.com' || request.auth.token.email == 'furrsocietyclan@gmail.com');
    }
  }
}
